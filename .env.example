# Copy to `.env` for local development, then fill in your Supabase connection
# strings (Supabase dashboard → Connect → ORMs / Prisma).
#
# DATABASE_URL  = the *Transaction pooler* string (port 6543). Used by the app
#                 at runtime, including Vercel serverless.
# DIRECT_URL    = the *Direct/Session* string (port 5432). Used only by the
#                 Prisma CLI for migrations.
#
# Both contain your database password — never commit the real .env.
#
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"

# This project's Supabase ref is: erjuwstfpseqhheajjhc (region us-west-2)

# Optional. Without it, ESA narratives and weekly reports fall back to the
# deterministic templates (the app stays fully demoable). AI never auto-submits.
# ANTHROPIC_API_KEY="sk-ant-..."
