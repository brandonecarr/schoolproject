# Copy to `.env` for local development, then fill in your Supabase connection
# strings (Supabase dashboard → Connect → ORMs / Prisma).
#
# DATABASE_URL  = the *Transaction pooler* string (port 6543). Used by the app
#                 at runtime, including Vercel serverless.
# DIRECT_URL    = the *Direct/Session* string (port 5432). Used only by the
#                 Prisma CLI for migrations.
#
# Both contain your database password — never commit the real .env.
#
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Note: use the pooler host for DIRECT_URL too (port 5432). The db.<ref>.supabase.co
#       host is IPv6-only and will not resolve from most networks.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# This project's Supabase ref is: erjuwstfpseqhheajjhc (region us-west-2)

# Optional. Without it, ESA narratives and weekly reports fall back to the
# deterministic templates (the app stays fully demoable). AI never auto-submits.
# ANTHROPIC_API_KEY="sk-ant-..."

# Required for the scheduled jobs in vercel.json (/api/cron/purge and
# /api/cron/watch-sources). Vercel sends it as `Authorization: Bearer <value>`.
# Both routes FAIL CLOSED without it — they return 503 rather than running
# unauthenticated, because an open fetch loop is a way to get our IP banned by
# a state education agency.
#   openssl rand -hex 32
# CRON_SECRET="..."

# Tier 3 (optional): let the interpreter open a pull request with a proposed
# rules.ts edit. Without these the proposal is still stored and reviewable in
# /proposals — it just doesn't become a PR, so adopting the automation is a
# separate, explicit decision from running the watcher.
# Token needs `contents: write` and `pull_requests: write` on this repo only.
# GITHUB_TOKEN="github_pat_..."
# GITHUB_REPO="brandonecarr/schoolproject"
# GITHUB_BASE_BRANCH="main"
