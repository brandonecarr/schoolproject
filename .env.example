# Copy to `.env` for local development.

# Local dev uses a SQLite file via the libsql driver adapter.
# For Vercel/production, point this at a Turso database and set the auth token
# below — same adapter, no code change (Vercel can't run a local SQLite file).
#   DATABASE_URL="libsql://<your-db>.turso.io"
DATABASE_URL="file:./dev.db"

# Only needed for a remote Turso database (leave unset for local file dev).
# DATABASE_AUTH_TOKEN="<turso-token>"

# Optional. Without it, ESA narratives and weekly reports fall back to the
# deterministic templates (the app stays fully demoable). AI never auto-submits.
# ANTHROPIC_API_KEY="sk-ant-..."
