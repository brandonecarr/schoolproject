# Copy to `.env` for local development, then fill in your Supabase connection
# strings (Supabase dashboard → Connect → ORMs / Prisma).
#
# DATABASE_URL  = the *Transaction pooler* string (port 6543). Used by the app
#                 at runtime, including Vercel serverless.
# DIRECT_URL    = the *Direct/Session* string (port 5432). Used only by the
#                 Prisma CLI for migrations.
#
# Both contain your database password — never commit the real .env.
#
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Note: use the pooler host for DIRECT_URL too (port 5432). The db.<ref>.supabase.co
#       host is IPv6-only and will not resolve from most networks.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# This project's Supabase ref is: erjuwstfpseqhheajjhc (region us-west-2)

# Optional. Without it, ESA narratives and weekly reports fall back to the
# deterministic templates (the app stays fully demoable). AI never auto-submits.
# ANTHROPIC_API_KEY="sk-ant-..."

# Required for the scheduled jobs in vercel.json (/api/cron/purge and
# /api/cron/watch-sources). Vercel sends it as `Authorization: Bearer <value>`.
# Both routes FAIL CLOSED without it — they return 503 rather than running
# unauthenticated, because an open fetch loop is a way to get our IP banned by
# a state education agency.
#   openssl rand -hex 32
# CRON_SECRET="..."

# Tier 3 (optional): let the interpreter open a pull request with a proposed
# rules.ts edit. Without these the proposal is still stored and reviewable in
# /proposals — it just doesn't become a PR, so adopting the automation is a
# separate, explicit decision from running the watcher.
# Token needs `contents: write` and `pull_requests: write` on this repo only.
# GITHUB_TOKEN="github_pat_..."
# GITHUB_REPO="brandonecarr/schoolproject"
# GITHUB_BASE_BRANCH="main"

# Email notifications (optional). Without these, alerts stay in-app only and
# nothing breaks — email is strictly an extra copy of the in-app notification,
# never a replacement, so delivery problems can't lose an alert.
# Provider is Resend: one HTTP POST, no SDK dependency, and the adapter in
# src/lib/email.ts is one function if you'd rather use Postmark or SES.
# EMAIL_FROM must be on a domain you've verified with the provider.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Cedar Grove <notices@yourdomain.com>"
# APP_URL="https://your-app.vercel.app"   # only needed if Vercel's own URL is wrong

# Set to "production" on the PRODUCTION environment ONLY. If a preview build can
# read it, that proves preview and production share variable scoping — which is
# the same reason they'd share a database — and the app shows a warning banner
# and refuses to run the retention purge. See src/lib/environment.ts.
# DB_ENVIRONMENT="production"

# Demo seed password. Unset means the seed generates a random one and prints it
# once. Never set this on a deployment.
# DEMO_PASSWORD="demo1234"

# Subdomain tenancy. UNSET = one school per deployment, which is how a laptop
# and every preview URL work; the app behaves exactly as it did before tenancy
# existed. Setting it turns subdomains on: the apex serves the landing page and
# signup, and each school lives at <slug>.<ROOT_DOMAIN>.
#
# Only set it once the wildcard DNS record (*.yourdomain) and a wildcard TLS
# certificate exist. Turning it on first sends every school to an address that
# does not resolve.
#
# To try it locally, set ROOT_DOMAIN="localhost:3000" — browsers resolve
# *.localhost to 127.0.0.1 without touching /etc/hosts — and open
# http://cedar-grove.localhost:3000.
# ROOT_DOMAIN="cohort.school"
