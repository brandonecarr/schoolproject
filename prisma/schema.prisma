// Cohort — data model.
//
// Ported from the Express MVP's JSON store (src/db.js). Notes on the port:
//  - SQLite has no enums, so role/status are plain String (see comments for
//    the allowed values). This also keeps the schema portable to Postgres later
//    with a one-line datasource change (roadmap 6.2).
//  - Date-only fields (attendance.date, dueDate, invoice periods) are stored as
//    "YYYY-MM-DD" strings on purpose: the evidence and billing logic compares
//    them lexicographically ("d >= start && d <= end"), which only works if they
//    stay strings. Timestamps (submittedAt, gradedAt) are ISO strings for the
//    same reason.
//  - Work-sample files are stored as bytes IN the database, not on disk. The
//    Express MVP wrote to data/uploads/, but Vercel's serverless filesystem is
//    read-only and ephemeral, so binary lives in the FileRec.data column.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model School {
  id        String   @id @default(cuid())
  name      String
  state     String
  esaAmount Float
  address   String   @default("")
  // COPPA: child data may not be kept indefinitely. Records older than this are
  // purged by the retention job. Configurable per school; 730 days = ~2 school years.
  retentionDays Int   @default(730)
  // Standards mastery: fraction of an aligned assignment's points a student must
  // earn for that attempt to count as "mastered" (0.8 = 80%).
  masteryThreshold Float @default(0.8)
  createdAt DateTime @default(now())
}

model User {
  id              String   @id @default(cuid())
  schoolId        String
  role            String // owner | teacher | parent | student
  name            String
  email           String   @unique
  password        String
  studentId       String? // set for role=student — the Student they represent
  studentIdsJson  String? // set for role=parent — JSON array of Student ids
  consentByUserId String? // parent user id that consented to a student account
  createdByParent Boolean  @default(false)
  consentGivenAt  String?
  createdAt       DateTime @default(now())
}

model Student {
  id            String   @id @default(cuid())
  schoolId      String
  name          String
  grade         String
  familyName    String
  esaProgram    String? // two-letter state key into PROGRAMS, or null for private pay
  esaAmount     Float    @default(0)
  tuitionAnnual Float    @default(0)
  createdAt     DateTime @default(now())
}

model Course {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  subject   String
  createdAt DateTime @default(now())
}

model Assignment {
  id           String   @id @default(cuid())
  schoolId     String
  courseId     String
  title        String
  instructions String   @default("")
  // "plain" for anything written before rich text existed, so old content keeps
  // rendering exactly as it always did. New content is authored as markdown.
  instructionsFormat String @default("markdown")
  dueDate      String // YYYY-MM-DD
  points       Int      @default(20)
  // How the work is given + completed. Drives the student completion UI and the
  // grading UI. See src/lib/lms.ts for the type registry and config shapes.
  type          String  @default("written") // written | quiz | upload | checkoff | rubric
  configJson    String  @default("") // type-specific: quiz items / rubric criteria / checkoff opts
  assignedAt    String  @default("") // YYYY-MM-DD availability; "" = available immediately
  allowResubmit Boolean @default(false)
  resourceFileId String? // teacher-attached resource (FileRec id), opened alongside instructions
  createdAt    DateTime @default(now())
}

model Submission {
  id           String   @id @default(cuid())
  schoolId     String
  assignmentId String
  studentId    String
  status       String // assigned | draft | submitted | returned | graded
  submittedAt  String? // ISO timestamp
  responseText String   @default("")
  score        Int?
  feedback     String   @default("")
  gradedAt     String? // ISO timestamp
  // Type-aware completion + grading.
  answersJson  String  @default("") // quiz answers / rubric per-criterion scores / checkoff state
  fileId       String? // upload-type: the FileRec the student turned in (also a work sample)
  autoScore    Int? // auto-graded portion (quiz MC/TF); manual grading adds to it
  returnedAt   String? // ISO — when a teacher returned it for revision
  revisionNote String  @default("") // teacher's note explaining the return
  draftSavedAt String? // ISO — last draft save
  createdAt    DateTime @default(now())
}

// A reusable worksheet the teacher builds once, then either prints/saves as PDF
// (worksheets/[id]/print) or assigns digitally (spawns a quiz-type Assignment).
// itemsJson uses the same Item[] shape as a quiz (see src/lib/lms.ts).
model Worksheet {
  id           String   @id @default(cuid())
  schoolId     String
  title        String
  subject      String   @default("")
  instructions String   @default("")
  instructionsFormat String @default("markdown")
  itemsJson    String   @default("[]")
  createdAt    DateTime @default(now())
}

// A reusable pool of questions. Write a question once, drop it into any quiz or
// worksheet later. itemsJson uses the same Item[] shape as everything else.
model ItemBank {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  subject   String   @default("")
  itemsJson String   @default("[]")
  createdAt DateTime @default(now())

  @@index([schoolId])
}

// --- Curriculum structure ------------------------------------------------
// Pages are teaching content (a lesson, a reading, a reference sheet). Modules
// sequence pages and assignments into a path a student works through in order.
// Structured, delivered instruction is also better ESA evidence than a flat
// pile of assignments.

model Page {
  id        String   @id @default(cuid())
  schoolId  String
  courseId  String? // null = school-wide
  title     String
  body      String   @default("")
  format    String   @default("markdown") // plain | markdown
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model Module {
  id             String   @id @default(cuid())
  schoolId       String
  courseId       String? // null = school-wide (orientation, etc.)
  name           String
  description    String   @default("")
  position       Int      @default(0)
  published      Boolean  @default(false)
  unlockAt       String   @default("") // YYYY-MM-DD; "" = available now
  requireSequential Boolean @default(false) // items must be done in order
  prereqModuleId String? // locked until that module is complete
  createdAt      DateTime @default(now())

  @@index([schoolId])
}

model ModuleItem {
  id       String  @id @default(cuid())
  schoolId String
  moduleId String
  kind     String // page | assignment | header
  refId    String  @default("") // Page id or Assignment id; empty for header
  title    String  @default("") // header text, or a label override
  position Int     @default(0)
  required Boolean @default(true) // counts toward module completion
  minScore Int? // assignment items: score needed to count as complete

  @@index([moduleId])
  @@index([schoolId])
}

// Completion for items that have no other record of being done — i.e. pages.
// Assignment completion is derived from Submission so the two can never drift.
model ModuleProgress {
  id           String   @id @default(cuid())
  schoolId     String
  studentId    String
  moduleItemId String
  completedAt  String // ISO timestamp
  createdAt    DateTime @default(now())

  @@unique([studentId, moduleItemId])
  @@index([schoolId])
}

// In-app notification for one user. Cohort's promise is "on time", so the
// people who need to act have to be told: a grade posted, work sent back, an
// absence reported, a report approved.
//
// In-app only for now — no email or push, and therefore no per-channel
// preferences yet. Those arrive together when a mail provider is chosen.
model Notification {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String // recipient
  type      String // graded | returned | submitted | absence | message | report | invoice
  title     String
  body      String   @default("")
  linkPath  String   @default("") // where clicking it should go
  readAt    String? // ISO timestamp — null = unread
  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([schoolId])
}

// A narrative progress report for one student over one period.
//
// GUARDRAIL: AI drafts, a human approves, nothing reaches a family on its own.
// A report is only visible to parents once status = "approved", and the record
// keeps who wrote it and who approved it.
model ProgressReport {
  id             String   @id @default(cuid())
  schoolId       String
  studentId      String
  periodStart    String // YYYY-MM-DD
  periodEnd      String // YYYY-MM-DD
  narrative      String   @default("")
  source         String   @default("template") // ai | template | edited
  status         String   @default("draft") // draft | approved
  createdById    String
  createdByName  String
  approvedAt     String? // ISO timestamp
  approvedByName String?
  createdAt      DateTime @default(now())

  @@index([schoolId])
  @@index([studentId])
}

// Every change to a score, with who made it and what it was before. Grades are
// the part of the record a state reviewer or a parent is most likely to
// challenge, so they need a defensible history — not just a current value.
model GradeChange {
  id            String   @id @default(cuid())
  schoolId      String
  submissionId  String
  studentId     String
  assignmentId  String
  oldScore      Int? // null = was ungraded
  newScore      Int?
  changedById   String
  changedByName String
  reason        String   @default("")
  at            String // ISO timestamp
  createdAt     DateTime @default(now())

  @@index([schoolId])
  @@index([studentId])
  @@index([submissionId])
}

// --- Standards / learning outcomes -------------------------------------
// The strongest ESA evidence a microschool can produce is documented progress
// against named standards. An Outcome is a standard the school teaches to;
// alignments tie it to the work that demonstrates it; results record each
// student attempt so mastery can be rolled up over a period.

model Outcome {
  id          String   @id @default(cuid())
  schoolId    String
  code        String // e.g. "4.NBT.B.5" — short label shown in grids
  title       String
  description String   @default("")
  subject     String   @default("")
  gradeBand   String   @default("") // e.g. "3-5"
  source      String   @default("custom") // custom | pack:<packKey>
  createdAt   DateTime @default(now())

  @@index([schoolId])
}

// An assignment (optionally one rubric criterion of it) demonstrates an outcome.
model OutcomeAlignment {
  id           String   @id @default(cuid())
  schoolId     String
  outcomeId    String
  assignmentId String
  criterionId  String? // rubric criterion id from Assignment.configJson, when scoped
  createdAt    DateTime @default(now())

  @@unique([outcomeId, assignmentId, criterionId])
  @@index([assignmentId])
  @@index([outcomeId])
}

// One recorded attempt at an outcome. Written automatically when aligned work is
// graded, or by hand from the mastery board.
model OutcomeResult {
  id           String   @id @default(cuid())
  schoolId     String
  studentId    String
  outcomeId    String
  assignmentId String?
  submissionId String?
  score        Float // points earned on the aligned work (or criterion)
  possible     Float // points available
  mastered     Boolean  @default(false)
  source       String   @default("graded") // graded | manual
  recordedAt   String // ISO timestamp — period filtering uses this
  createdAt    DateTime @default(now())

  @@index([studentId, outcomeId])
  @@index([schoolId])
}

model Attendance {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  date      String // YYYY-MM-DD
  status    String // present | absent | excused
  note      String   @default("")
  createdAt DateTime @default(now())
}

model Observation {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  date      String // YYYY-MM-DD
  text      String
  author    String
  createdAt DateTime @default(now())
}

model FileRec {
  id         String   @id @default(cuid())
  schoolId   String
  studentId  String? // null for teacher-attached assignment resources (no child)
  label      String
  ext        String
  mime       String
  bytes      Int
  data       Bytes
  capturedAt String // ISO timestamp
  createdAt  DateTime @default(now())
}

model Payment {
  id         String   @id @default(cuid())
  schoolId   String
  studentId  String
  payer      String // family
  amount     Float
  receivedAt String // ISO timestamp
  method     String   @default("manual")
  createdAt  DateTime @default(now())
}

model Invoice {
  id              String   @id @default(cuid())
  schoolId        String
  studentId       String
  periodStart     String // YYYY-MM-DD
  periodEnd       String // YYYY-MM-DD
  amount          Float
  status          String // draft | submitted | approved | paid | rejected
  narrative       String   @default("")
  narrativeSource String   @default("template") // template | ai | edited
  evidenceScore   Int      @default(0)
  railId          String?
  submittedAt     String? // ISO timestamp — latest submission
  approvedAt      String? // ISO timestamp
  paidAt          String? // ISO timestamp
  rejectedAt      String? // ISO timestamp — most recent rejection
  rejectionReason String   @default("")
  rejectionCount  Int      @default(0) // how many times this invoice was rejected (drives first-pass rate)
  createdAt       DateTime @default(now())
}

model Session {
  id        String   @id
  userId    String
  createdAt DateTime @default(now())
}

model Audit {
  id        String   @id @default(cuid())
  at        String // ISO timestamp
  actorId   String?
  action    String
  detail    String   @default("")
  createdAt DateTime @default(now())
}

// Family ↔ school messages. A thread is keyed by studentId: all school staff,
// the child's parent(s), and the child's student login share one conversation.
// Two read flags (per side) drive the unread badges.
model Message {
  id           String   @id @default(cuid())
  schoolId     String
  studentId    String // the child the thread is about
  senderId     String
  senderRole   String // owner | teacher | parent | student
  senderName   String
  body         String
  readByStaff  Boolean  @default(false)
  readByFamily Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// One-time links for onboarding + password reset. Replaces the shared demo1234
// password. Link-based (no email dependency): the teacher/owner shares the URL.
model Token {
  id        String   @id @default(cuid())
  token     String   @unique // the secret in the URL
  type      String // parent_invite | password_reset
  schoolId  String
  userId    String? // password_reset: the existing user
  email     String? // parent_invite: email of the account to create
  name      String? // parent_invite: parent name
  studentId String? // parent_invite: child to link
  expiresAt String // ISO timestamp
  usedAt    String? // ISO timestamp — null until consumed
  createdAt DateTime @default(now())
}
