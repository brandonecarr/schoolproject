// Cohort — data model.
//
// Ported from the Express MVP's JSON store (src/db.js). Notes on the port:
//  - SQLite has no enums, so role/status are plain String (see comments for
//    the allowed values). This also keeps the schema portable to Postgres later
//    with a one-line datasource change (roadmap 6.2).
//  - Date-only fields (attendance.date, dueDate, invoice periods) are stored as
//    "YYYY-MM-DD" strings on purpose: the evidence and billing logic compares
//    them lexicographically ("d >= start && d <= end"), which only works if they
//    stay strings. Timestamps (submittedAt, gradedAt) are ISO strings for the
//    same reason.
//  - Work-sample files are stored as bytes IN the database, not on disk. The
//    Express MVP wrote to data/uploads/, but Vercel's serverless filesystem is
//    read-only and ephemeral, so binary lives in the FileRec.data column.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model School {
  id        String   @id @default(cuid())
  name      String
  /// The school's subdomain: cedar-grove.<root domain>. Public and effectively
  /// permanent — it is in every link the school has sent a family, in their
  /// bookmarks, and in the iCal URLs parents have already subscribed to. It is
  /// deliberately NOT regenerated when the school's name is edited.
  slug      String   @unique
  state     String
  esaAmount Float
  address   String   @default("")
  // COPPA: child data may not be kept indefinitely. Records older than this are
  // purged by the retention job. Configurable per school; 730 days = ~2 school years.
  retentionDays Int   @default(730)
  // Standards mastery: fraction of an aligned assignment's points a student must
  // earn for that attempt to count as "mastered" (0.8 = 80%).
  masteryThreshold Float @default(0.8)
  // Which weekdays are instructional, as ISO numbers (1=Mon … 7=Sun). Not
  // cosmetic: it sets the denominator of "present N of M instructional days" on
  // every ESA invoice, and plenty of microschools deliberately run four days.
  schoolDays String @default("1,2,3,4,5")

  // --- Identity on the documents that leave the building --------------------
  // A reimbursement packet is read by a state reviewer who has never heard of
  // us. It should arrive on the SCHOOL's letterhead, not the vendor's; a packet
  // headed "Cohort" reads as though a software company is making the claim,
  // when the school is the one attesting to it.
  //
  // The logo is a FileRec with a null studentId (not child data — see the
  // retention purge, which is scoped away from these on purpose).
  logoFileId  String?
  // Hex, e.g. "#1F3A6E". Empty means "use the Cohort default". Never trusted
  // raw: see lib/branding.ts, which rejects anything that isn't a hex colour
  // and picks a foreground that actually meets contrast against it.
  accentColor String @default("")

  // --- Identity with whoever administers the money --------------------------
  // The number a reviewer matches an invoice against: the ClassWallet vendor
  // ID, the Step Up provider ID, the state's approved-provider number. It goes
  // on the packet, which is the point — our packets carried no such number.
  //
  // Cohort CANNOT check any of these. Every marketplace is behind the school's
  // own login; there is no public directory and no API. So this is a claim the
  // school makes, dated and attributed, never a verification we performed. See
  // the header of src/lib/provider.ts for why that distinction is load-bearing.
  providerId          String  @default("")
  // Which administrator issued it — a rail id from lib/rules.ts. Stored rather
  // than derived from `state`, because a state can re-bid its contract and a
  // multi-state operator can sit on a rail its address does not imply. A wrong
  // administrator on a packet is a guaranteed rejection.
  providerRail        String  @default("")
  // ISO date someone last said "yes, this is still active". Status (none /
  // attested / stale) is DERIVED from this in provider.ts, never stored — a
  // stored status is a second copy of the truth that drifts on the first edit.
  providerAttestedAt  String?
  // Who said it. An attestation with nobody behind it is not an attestation.
  providerAttestedById String?

  // --- Onboarding intake: the popup owners see on first sign-in ----------
  // Context for the operator, not features: who to call, how big the school
  // expects to be, where they came from. onboardedAt null means the popup
  // still shows; saving OR skipping stamps it, because a nag that cannot be
  // dismissed teaches people to hate the product on day one.
  contactPhone    String   @default("")
  studentEstimate Int      @default(0)
  gradesServed    String   @default("")
  heardFrom       String   @default("")
  priorTooling    String   @default("")
  onboardedAt     DateTime?

  // --- Cohort billing (the SaaS subscription, never ESA money) -------------
  // Set when the school is created through paid checkout; subscriptionStatus
  // is maintained by the Stripe webhook (active | past_due | canceled | ...).
  // Empty strings mean the school predates billing or was provisioned in a
  // deployment without Stripe configured.
  stripeCustomerId     String @default("")
  stripeSubscriptionId String @default("")
  subscriptionStatus   String @default("")

  createdAt DateTime @default(now())
}

model User {
  id              String   @id @default(cuid())
  // Secret in the iCal subscription URL. Calendar clients cannot send an
  // Authorization header, so the URL itself is the credential — long-lived,
  // revocable by regenerating, and scoped to calendar data only.
  calendarToken   String?  @unique
  // Nav shortcuts, as a JSON array of hrefs. Pins only — teachers cannot rename
  // or reorder the groups, so a new feature always lands in its proper group
  // whether or not anything is pinned. See the note in src/lib/nav.ts.
  pinnedNav       String?
  // Email alongside in-app notifications. Default ON for families (the point is
  // that they find out) and OFF for staff, who live in the app all day and would
  // just be emailing themselves about their own school.
  emailAlerts     Boolean  @default(true)
  /// Platform operator: may open /cohort-admin, which reads across schools.
  /// Granted only by scripts (grant-admin.mjs, create-operator.mjs) — no UI
  /// can set it, so a compromised teacher account cannot escalate itself.
  platformAdmin   Boolean  @default(false)
  /// Null for platform operators — the operator is not a tenant. Every
  /// school-role gate narrows this to non-null before any scoped code runs.
  schoolId        String?
  role            String // owner | teacher | parent | student | admin
  name            String
  /// Unique per SCHOOL, not globally. The same person legitimately holds two
  /// accounts in this market: a parent with children in two programmes, or a
  /// teacher who works at a co-op as well as their own microschool. A global
  /// unique index turns that into "this email is taken" with no way forward.
  /// Login is therefore always tenant-scoped — see the subdomain middleware.
  email           String
  password        String
  studentId       String? // set for role=student — the Student they represent
  studentIdsJson  String? // set for role=parent — JSON array of Student ids
  consentByUserId String? // parent user id that consented to a student account
  createdByParent Boolean  @default(false)
  consentGivenAt  String?
  createdAt       DateTime @default(now())

  @@unique([schoolId, email])
  @@index([email])
}

model Student {
  id            String   @id @default(cuid())
  schoolId      String
  name          String
  grade         String
  familyName    String
  esaProgram    String? // two-letter state key into PROGRAMS, or null for private pay
  esaAmount     Float    @default(0)
  tuitionAnnual Float    @default(0)
  createdAt     DateTime @default(now())
}

model Course {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  subject   String
  createdAt DateTime @default(now())
}

model Assignment {
  id           String   @id @default(cuid())
  schoolId     String
  courseId     String
  title        String
  instructions String   @default("")
  // "plain" for anything written before rich text existed, so old content keeps
  // rendering exactly as it always did. New content is authored as markdown.
  instructionsFormat String @default("markdown")
  dueDate      String // YYYY-MM-DD
  points       Int      @default(20)
  // How the work is given + completed. Drives the student completion UI and the
  // grading UI. See src/lib/lms.ts for the type registry and config shapes.
  type          String  @default("written") // written | quiz | upload | checkoff | rubric
  configJson    String  @default("") // type-specific: quiz items / rubric criteria / checkoff opts
  assignedAt    String  @default("") // YYYY-MM-DD availability; "" = available immediately
  allowResubmit Boolean @default(false)
  resourceFileId String? // teacher-attached resource (FileRec id), opened alongside instructions
  createdAt    DateTime @default(now())
}

model Submission {
  id           String   @id @default(cuid())
  schoolId     String
  assignmentId String
  studentId    String
  status       String // assigned | draft | submitted | returned | graded
  submittedAt  String? // ISO timestamp
  responseText String   @default("")
  score        Int?
  feedback     String   @default("")
  gradedAt     String? // ISO timestamp
  // Type-aware completion + grading.
  answersJson  String  @default("") // quiz answers / rubric per-criterion scores / checkoff state
  fileId       String? // upload-type: the FileRec the student turned in (also a work sample)
  autoScore    Int? // auto-graded portion (quiz MC/TF); manual grading adds to it
  returnedAt   String? // ISO — when a teacher returned it for revision
  revisionNote String  @default("") // teacher's note explaining the return
  draftSavedAt String? // ISO — last draft save
  // Set when a mastery path assigned this work automatically, so the student
  // can see why it appeared and the record shows the instruction was targeted.
  assignedReason String @default("")
  createdAt    DateTime @default(now())
}

// A reusable worksheet the teacher builds once, then either prints/saves as PDF
// (worksheets/[id]/print) or assigns digitally (spawns a quiz-type Assignment).
// itemsJson uses the same Item[] shape as a quiz (see src/lib/lms.ts).
model Worksheet {
  id           String   @id @default(cuid())
  schoolId     String
  title        String
  subject      String   @default("")
  instructions String   @default("")
  instructionsFormat String @default("markdown")
  itemsJson    String   @default("[]")
  createdAt    DateTime @default(now())
}

// Mastery path: "when a student scores in THIS range on THIS assignment, give
// them THAT one next." Support for the student who struggled, extension for the
// one who raced ahead — and both are documented automatically, which is exactly
// the individualised-instruction evidence an ESA reviewer wants to see.
//
// The range is an inclusive percentage band, so one code path covers "below
// 70", "70 and above", and "between 50 and 79".
model PathRule {
  id               String   @id @default(cuid())
  schoolId         String
  assignmentId     String // the trigger
  minPct           Int      @default(0)
  maxPct           Int      @default(100)
  thenAssignmentId String // what to assign next
  note             String   @default("") // shown to the student, in the teacher's words
  createdAt        DateTime @default(now())

  @@index([schoolId])
  @@index([assignmentId])
}

// A reusable pool of questions. Write a question once, drop it into any quiz or
// worksheet later. itemsJson uses the same Item[] shape as everything else.
model ItemBank {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  subject   String   @default("")
  itemsJson String   @default("[]")
  createdAt DateTime @default(now())

  @@index([schoolId])
}

// --- Curriculum structure ------------------------------------------------
// Pages are teaching content (a lesson, a reading, a reference sheet). Modules
// sequence pages and assignments into a path a student works through in order.
// Structured, delivered instruction is also better ESA evidence than a flat
// pile of assignments.

model Page {
  id        String   @id @default(cuid())
  schoolId  String
  courseId  String? // null = school-wide
  title     String
  body      String   @default("")
  format    String   @default("markdown") // plain | markdown
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model Module {
  id             String   @id @default(cuid())
  schoolId       String
  courseId       String? // null = school-wide (orientation, etc.)
  name           String
  description    String   @default("")
  position       Int      @default(0)
  published      Boolean  @default(false)
  unlockAt       String   @default("") // YYYY-MM-DD; "" = available now
  requireSequential Boolean @default(false) // items must be done in order
  prereqModuleId String? // locked until that module is complete
  createdAt      DateTime @default(now())

  @@index([schoolId])
}

model ModuleItem {
  id       String  @id @default(cuid())
  schoolId String
  moduleId String
  kind     String // page | assignment | header
  refId    String  @default("") // Page id or Assignment id; empty for header
  title    String  @default("") // header text, or a label override
  position Int     @default(0)
  required Boolean @default(true) // counts toward module completion
  minScore Int? // assignment items: score needed to count as complete

  @@index([moduleId])
  @@index([schoolId])
}

// Completion for items that have no other record of being done — i.e. pages.
// Assignment completion is derived from Submission so the two can never drift.
model ModuleProgress {
  id           String   @id @default(cuid())
  schoolId     String
  studentId    String
  moduleItemId String
  completedAt  String // ISO timestamp
  createdAt    DateTime @default(now())

  @@unique([studentId, moduleItemId])
  @@index([schoolId])
}

// In-app notification for one user. Cohort's promise is "on time", so the
// people who need to act have to be told: a grade posted, work sent back, an
// absence reported, a report approved.
//
// In-app only for now — no email or push, and therefore no per-channel
// preferences yet. Those arrive together when a mail provider is chosen.
model Notification {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String // recipient
  type      String // graded | returned | submitted | absence | message | report | invoice
  title     String
  body      String   @default("")
  linkPath  String   @default("") // where clicking it should go
  readAt    String? // ISO timestamp — null = unread
  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([schoolId])
}

// A narrative progress report for one student over one period.
//
// GUARDRAIL: AI drafts, a human approves, nothing reaches a family on its own.
// A report is only visible to parents once status = "approved", and the record
// keeps who wrote it and who approved it.
model ProgressReport {
  id             String   @id @default(cuid())
  schoolId       String
  studentId      String
  periodStart    String // YYYY-MM-DD
  periodEnd      String // YYYY-MM-DD
  narrative      String   @default("")
  source         String   @default("template") // ai | template | edited
  status         String   @default("draft") // draft | approved
  createdById    String
  createdByName  String
  approvedAt     String? // ISO timestamp
  approvedByName String?
  createdAt      DateTime @default(now())

  @@index([schoolId])
  @@index([studentId])
}

// Every change to a score, with who made it and what it was before. Grades are
// the part of the record a state reviewer or a parent is most likely to
// challenge, so they need a defensible history — not just a current value.
model GradeChange {
  id            String   @id @default(cuid())
  schoolId      String
  submissionId  String
  studentId     String
  assignmentId  String
  oldScore      Int? // null = was ungraded
  newScore      Int?
  changedById   String
  changedByName String
  reason        String   @default("")
  at            String // ISO timestamp
  createdAt     DateTime @default(now())

  @@index([schoolId])
  @@index([studentId])
  @@index([submissionId])
}

// --- Standards / learning outcomes -------------------------------------
// The strongest ESA evidence a microschool can produce is documented progress
// against named standards. An Outcome is a standard the school teaches to;
// alignments tie it to the work that demonstrates it; results record each
// student attempt so mastery can be rolled up over a period.

model Outcome {
  id          String   @id @default(cuid())
  schoolId    String
  code        String // e.g. "4.NBT.B.5" — short label shown in grids
  title       String
  description String   @default("")
  subject     String   @default("")
  gradeBand   String   @default("") // e.g. "3-5"
  source      String   @default("custom") // custom | pack:<packKey>
  createdAt   DateTime @default(now())

  @@index([schoolId])
}

// An assignment (optionally one rubric criterion of it) demonstrates an outcome.
model OutcomeAlignment {
  id           String   @id @default(cuid())
  schoolId     String
  outcomeId    String
  assignmentId String
  criterionId  String? // rubric criterion id from Assignment.configJson, when scoped
  createdAt    DateTime @default(now())

  @@unique([outcomeId, assignmentId, criterionId])
  @@index([assignmentId])
  @@index([outcomeId])
}

// One recorded attempt at an outcome. Written automatically when aligned work is
// graded, or by hand from the mastery board.
model OutcomeResult {
  id           String   @id @default(cuid())
  schoolId     String
  studentId    String
  outcomeId    String
  assignmentId String?
  submissionId String?
  score        Float // points earned on the aligned work (or criterion)
  possible     Float // points available
  mastered     Boolean  @default(false)
  source       String   @default("graded") // graded | manual
  recordedAt   String // ISO timestamp — period filtering uses this
  createdAt    DateTime @default(now())

  @@index([studentId, outcomeId])
  @@index([schoolId])
}

model Attendance {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  date      String // YYYY-MM-DD
  status    String // present | absent | excused
  note      String   @default("")
  createdAt DateTime @default(now())
}

model Observation {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  date      String // YYYY-MM-DD
  text      String
  author    String
  createdAt DateTime @default(now())
}

model FileRec {
  id         String   @id @default(cuid())
  schoolId   String
  studentId  String? // null for teacher-attached assignment resources (no child)
  /// Set when this file is an EXPENSE RECEIPT attached to a reimbursement
  /// invoice — the itemised proof of purchase a reviewer matches against the
  /// amount claimed. Receipts carry studentId: null on purpose: studentId is
  /// the marker for child data on the COPPA retention clock, and a receipt is
  /// a financial record kept for reimbursement audit, not child activity.
  /// Right-to-deletion still removes them via their invoice (retention.ts).
  invoiceId  String?
  label      String
  ext        String
  mime       String
  bytes      Int
  data       Bytes
  capturedAt String // ISO timestamp
  createdAt  DateTime @default(now())
}

model Payment {
  id         String   @id @default(cuid())
  schoolId   String
  studentId  String
  payer      String // family
  amount     Float
  receivedAt String // ISO timestamp
  method     String   @default("manual")
  createdAt  DateTime @default(now())
}

model Invoice {
  id              String   @id @default(cuid())
  schoolId        String
  studentId       String
  periodStart     String // YYYY-MM-DD
  periodEnd       String // YYYY-MM-DD
  amount          Float
  status          String // draft | submitted | approved | paid | rejected
  narrative       String   @default("")
  narrativeSource String   @default("template") // template | ai | edited
  evidenceScore   Int      @default(0)
  railId          String?
  submittedAt     String? // ISO timestamp — latest submission
  approvedAt      String? // ISO timestamp
  paidAt          String? // ISO timestamp
  rejectedAt      String? // ISO timestamp — most recent rejection
  rejectionReason String   @default("")
  rejectionCount  Int      @default(0) // how many times this invoice was rejected (drives first-pass rate)
  createdAt       DateTime @default(now())
}

model Session {
  id        String   @id
  userId    String
  // Set while a staff member is viewing the app as a family member, to answer
  // "what does Dana actually see?". READ-ONLY by construction: getSession swaps
  // in this user, so requireTeacher() sees a parent/student role and every
  // teacher page and action refuses; the twelve portal actions refuse
  // explicitly. Stored on the session rather than in a cookie so it cannot be
  // forged, and so it ends when the session does.
  viewingAsUserId String?
  createdAt DateTime @default(now())
}

model Audit {
  id        String   @id @default(cuid())
  at        String // ISO timestamp
  actorId   String?
  action    String
  detail    String   @default("")
  createdAt DateTime @default(now())
}

// Family ↔ school messages. A thread is keyed by studentId: all school staff,
// the child's parent(s), and the child's student login share one conversation.
// Two read flags (per side) drive the unread badges.
model Message {
  id           String   @id @default(cuid())
  schoolId     String
  studentId    String // the child the thread is about
  senderId     String
  senderRole   String // owner | teacher | parent | student
  senderName   String
  body         String
  readByStaff  Boolean  @default(false)
  readByFamily Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// A program obligation with a date on it: the SLP renewal, the quarterly
// expense report, the annual contract. THE SCHOOL SETS THE DATE — rules.ts
// suggests which obligations a program typically carries (⚑ from public
// writing), but the date that counts is the one on the family's award letter
// or the program portal, and only the school can read those. Missing one of
// these can cost a family a year of funding, which is why an invented date
// would be worse than no reminder at all.
model ComplianceDeadline {
  id          String   @id @default(cuid())
  schoolId    String
  /// State code this belongs to ("FL"), or "" for a school-wide obligation.
  programCode String   @default("")
  label       String
  dueDate     String // YYYY-MM-DD
  note        String   @default("")
  /// ISO timestamp when the school marked it handled; null while open.
  completedAt String?
  createdAt   DateTime @default(now())

  @@index([schoolId])
}

// One-time links for onboarding + password reset. Replaces the shared demo1234
// password. Link-based (no email dependency): the teacher/owner shares the URL.
model Token {
  id        String   @id @default(cuid())
  token     String   @unique // the secret in the URL
  type      String // parent_invite | password_reset
  schoolId  String
  userId    String? // password_reset: the existing user
  email     String? // parent_invite: email of the account to create
  name      String? // parent_invite: parent name
  studentId String? // parent_invite: child to link
  expiresAt String // ISO timestamp
  usedAt    String? // ISO timestamp — null until consumed
  createdAt DateTime @default(now())
}

// Ground truth about how a rail actually behaves, one immutable row per
// real-world outcome. This is the table that eventually retires the ⚑ verify
// flags in src/lib/rules.ts: those flags say "we guessed", and the only thing
// that can honestly clear them is an observed invoice cycle. Nothing in here is
// ever inferred, scraped, or written by a model — it is only ever recorded from
// something a state or vendor actually did to a real invoice.
//
// Append-only by convention: Invoice.rejectionReason holds only the LATEST
// rejection, so the history used to be destroyed on every rework. These rows
// are the history.
model RailObservation {
  id          String  @id @default(cuid())
  schoolId    String
  invoiceId   String
  railId      String
  programCode String? // state code at the time of the outcome, for per-program rollups
  outcome     String // approved | paid | rejected
  // The reason EXACTLY as the portal worded it. Never normalised, never
  // trimmed to a preset — the verbatim text IS the asset, because the preset
  // taxonomy is what we are trying to learn.
  reasonRaw   String  @default("")
  // Which RAILS[].rejectionReasons entry the teacher filed it under. Empty
  // means none of them fit: those rows are how the taxonomy grows.
  reasonKey   String  @default("")
  observedAt  String // ISO timestamp
  recordedBy  String? // user id — who witnessed it

  createdAt DateTime @default(now())

  @@index([railId])
  @@index([schoolId])
  @@index([invoiceId])
}

// Tier-1 watcher state: one mutable row per source in src/lib/sources.ts.
// Answers "is the watcher healthy", which matters because the failure mode of a
// scraper is silence — a source that has been 403ing for three weeks looks
// exactly like a source where nothing has changed.
model WatchState {
  id             String  @id @default(cuid())
  sourceId       String  @unique // slug from SOURCES — not a foreign key, the registry lives in code
  lastCheckedAt  String? // ISO — when we last successfully reached it
  lastAttemptAt  String? // ISO — when we last tried, successful or not
  lastChangedAt  String? // ISO — a source that has NEVER changed is suspicious, not reassuring
  lastHash       String?
  lastStatus     String  @default("new") // ok | http_error | fetch_error | too_small
  lastError      String  @default("")
  failureStreak  Int     @default(0)
  /** Escalated to Tier 2 but not yet interpreted. Step 3 drains this. */
  pendingReview  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Append-only, written ONLY when a source's fingerprint actually changes. That
// keeps storage proportional to real change (a few dozen rows a year) rather
// than to polling frequency, and each consecutive pair is exactly the
// before/after that Tier 2 needs to interpret.
model SourceSnapshot {
  id         String  @id @default(cuid())
  sourceId   String
  url        String
  hash       String
  /** Normalised, extracted text at this point in time — the diff material. */
  text       String
  fetchedAt  String // ISO
  httpStatus Int     @default(0)
  /** Net character change against the previous snapshot; negative often means
   *  the page broke rather than that content was removed. */
  delta      Int     @default(0)
  /** 0..1 share of tokens that moved. */
  magnitude  Float   @default(0)
  /** Whether this change cleared the bar for a Tier-2 model call. */
  escalated  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([sourceId, fetchedAt])
}

// A proposed change to src/lib/rules.ts, drafted by the Tier-2 interpreter from
// an observed source change. NEVER applied automatically — the whole point of
// this table is that it sits between "a page moved" and "a school bills against
// a different number", with a human in the gap.
//
// One row per interpreted snapshot, including the ones judged immaterial: a
// recorded "no, that was a footer tweak" is what stops us re-spending a model
// call on the same diff, and is itself evidence when a rule turns out to have
// changed and we missed it.
model RuleProposal {
  id         String @id @default(cuid())
  sourceId   String
  snapshotId String @unique // the change that triggered this — also the idempotency key

  /** Did the model judge this a real rule change? Most are false. */
  material   Boolean @default(false)
  confidence String  @default("low") // high | medium | low
  summary    String  @default("")
  /** Field-level claims as JSON: [{field, before, after, quote}]. Constrained
   *  to a whitelist — see PATCHABLE in src/lib/propose.ts. */
  changesJson String @default("[]")
  /** Verbatim passages from the page that support the claim. Without these a
   *  proposal is an assertion; with them a reviewer can check it in seconds. */
  programCode String?
  railId      String?

  /** The mechanically generated edit to rules.ts. Not model-written. */
  patch String @default("")

  status  String  @default("open") // open | pr_opened | accepted | rejected | superseded
  prUrl   String  @default("")
  /** Why a human rejected it — trains our judgement about the source, and is
   *  the signal that a source is producing noise and should be re-pointed. */
  decidedBy   String?
  decidedAt   String?
  decisionNote String @default("")

  model     String   @default("")
  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([sourceId])
}


// The school's published calendar. Three kinds, doing quite different jobs:
//   term     the range instruction is in session — the OUTER bound on what can
//            be billed as an instructional day
//   closure  a day inside a term that is not instructional (holiday, in-service,
//            snow day). Subtracted from the term.
//   event    everything else — field trips, picture day, parent evenings. Shown
//            to families and exported, but never affects the instructional count.
//
// Both dates are inclusive "YYYY-MM-DD". Note that iCal's DTEND for an all-day
// event is EXCLUSIVE, so the serializer adds a day; see src/lib/calendar.ts.
model CalendarEvent {
  id        String  @id @default(cuid())
  schoolId  String
  kind      String // term | closure | event
  title     String
  startDate String // YYYY-MM-DD, inclusive
  endDate   String // YYYY-MM-DD, inclusive
  note      String  @default("")
  /** Hide from the family-facing calendar and the iCal feed. Staff in-service
   *  days are a closure families should see; some planning notes are not. */
  staffOnly Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([schoolId, startDate])
}

// One-to-many broadcast from the school to families.
//
// Deliberately distinct from the two things it looks like:
//   Message      is a 1:1 thread about ONE child. "School closed Friday" is not
//                a conversation and should not fork into twelve of them.
//   Notification is delivery, not content — it carries a title and a link and
//                is marked read. An announcement is the thing being linked TO,
//                and it stays readable after the notification is dismissed.
//
// Publishing an announcement CREATES notifications; the two are layers, not
// alternatives.
model Announcement {
  id         String  @id @default(cuid())
  schoolId   String
  authorId   String
  authorName String
  title      String
  body       String  @default("")
  bodyFormat String  @default("markdown") // markdown | plain

  /** all | parents | students. Staff always see everything. */
  audience String @default("all")
  /** Sticks to the top of the family list — for "start here" notices. */
  pinned   Boolean @default(false)
  /** Ask recipients to confirm they have read it. Turns a broadcast into a
   *  record, which is what a school actually needs for a closure or a policy. */
  requireAck Boolean @default(false)

  /** Null means draft. Set once, on publish — editing afterwards does NOT
   *  re-notify, because a typo fix should not ping forty phones. */
  publishedAt String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, publishedAt])
}

model AnnouncementAck {
  id             String   @id @default(cuid())
  announcementId String
  userId         String
  at             String // ISO timestamp
  createdAt      DateTime @default(now())

  // One acknowledgement per person — a second click is not a second reader.
  @@unique([announcementId, userId])
  @@index([announcementId])
}

// A pinned comment on a point of a student's uploaded work.
//
// IMAGES ONLY. Annotating a PDF needs a renderer to know where page 2 is on
// screen; that is a different feature and pretending otherwise would put pins
// in the wrong place.
//
// Coordinates are FRACTIONS of the image (0..1), never pixels. The same photo
// renders at 320px in the grading queue, full width on a phone, and at print
// scale in the ESA packet — a pixel offset would be wrong in two of those three.
//
// Worth more than the feature sounds: "here is the child's work with the
// teacher's specific marks on it" is far stronger evidence of instruction
// delivered than a score, and it is exactly what rails ask to see.
model Annotation {
  id           String @id @default(cuid())
  schoolId     String
  submissionId String
  fileId       String
  /** 0..1 from the left edge. */
  x            Float
  /** 0..1 from the top edge. */
  y            Float
  body         String
  authorId     String
  authorName   String

  createdAt DateTime @default(now())

  @@index([submissionId])
  @@index([fileId])
}

// A piece the student has CHOSEN for their portfolio, with their reflection on
// it.
//
// The distinction from the automatic gallery it replaces is the whole point. A
// list of everything a child produced is a filing cabinet; a short set they
// picked, each with a sentence on why it matters, is a portfolio. The choosing
// and the explaining are the educational part — and a child articulating what
// they learned is stronger evidence of instruction than any teacher assertion
// about the same work.
//
// PRIVATE BY CONSTRUCTION. There is no share token, no public route, and no
// "publish" action anywhere in this feature, deliberately: this is a named
// child's work and their own words about it. Family and school only.
model PortfolioEntry {
  id       String @id @default(cuid())
  schoolId String
  studentId String

  // Exactly one of these is set — a graded submission, or a work-sample file.
  submissionId String?
  fileId       String?

  /** The student's own title for the piece, which may not be the assignment's. */
  title            String
  reflection       String @default("")
  reflectionFormat String @default("markdown")

  /** Display order, lowest first. Normalised on every move — see lib/portfolio.ts. */
  position Int @default(0)

  /** A teacher may add a piece too ("this belongs in your portfolio"), and the
   *  portfolio should say which of them chose it. */
  addedByRole String @default("student") // student | teacher
  addedByName String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, position])
}

// A parent-teacher conference slot.
//
// Times are stored as a date string plus MINUTES FROM MIDNIGHT, not as
// timestamps. A conference is inherently a local-time appointment — "Tuesday at
// half three" — and storing an instant would mean picking a timezone, getting
// it wrong across DST, and rendering something different from what the teacher
// typed. Same reasoning as the rest of the domain's date-only fields.
//
// The slot is the unit: the teacher publishes empty ones and a family claims a
// single slot. Claiming is an atomic conditional update (see bookConference) so
// two parents clicking at the same moment cannot both win.
model ConferenceSlot {
  id       String @id @default(cuid())
  schoolId String
  date     String // YYYY-MM-DD
  startMin Int // minutes from midnight, e.g. 930 = 3:30pm
  endMin   Int
  location String @default("")

  /** Null until a family claims it. */
  studentId      String?
  bookedByUserId String?
  bookedByName   String  @default("")
  bookedAt       String? // ISO

  /** Written afterwards. A documented conference with a note is exactly the
   *  family-engagement evidence some ESA programs like to see, so it surfaces
   *  on the student's printed record rather than living only here. */
  note       String @default("")
  noteFormat String @default("markdown")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, date])
  @@index([studentId])
}

// A prospect from the marketing surface — the walkthrough button, a manual
// entry after a call, wherever. PLATFORM TABLE: no schoolId on purpose,
// because a lead precedes tenancy; only /admin (platformAdmin) ever reads it.
model Lead {
  id        String   @id @default(cuid())
  name      String   @default("")
  email     String
  /// Where it came from: walkthrough | manual | find | ...
  source    String   @default("manual")
  note      String   @default("")
  /// The US state the prospect says they operate in — the single most
  /// useful qualifier for a walkthrough, so it is asked at booking.
  state     String   @default("")
  /// Campaign attribution: the coh_ref cookie value at booking time, from a
  /// ?ref= or ?utm_source= on the visitor's first landing. Empty for manual
  /// leads and unattributed visitors.
  ref       String   @default("")
  /// new | contacted | scheduled | won | lost
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@index([status])
}

// A bookable walkthrough slot — the Calendly piece. PLATFORM TABLE: slots
// belong to the operator, not to any school. leadId doubles as the booked
// flag; claiming is an atomic update WHERE leadId IS NULL, so two prospects
// racing for the same slot cannot both win.
model WalkthroughSlot {
  id          String   @id @default(cuid())
  startsAt    DateTime
  durationMin Int      @default(20)
  leadId      String?
  createdAt   DateTime @default(now())

  @@index([startsAt])
}

// A record of every email blast the console has sent. The body is kept
// verbatim: "what exactly did we tell people" is a question that will come
// up, and the answer should not depend on anyone's memory.
model EmailBlast {
  id        String   @id @default(cuid())
  audience  String
  subject   String
  body      String
  sentCount Int
  createdAt DateTime @default(now())
}

// Daily aggregate page views for the PUBLIC marketing pages only — the
// beacon's allowlist keeps app surfaces out. PLATFORM TABLE, and deliberately
// privacy-light: a day, a path, a referrer hostname, a count. No IPs, no
// user agents, no cookies read, nothing per-visitor.
model PageView {
  id           String @id @default(cuid())
  day          String // YYYY-MM-DD (UTC)
  path         String
  referrerHost String @default("")
  count        Int    @default(0)

  @@unique([day, path, referrerHost])
}

// Recurring availability, Calendly-style: "Mondays 9:00-11:00, 20-minute
// slots, America/Phoenix". Open times on /book are GENERATED from these
// rules; only actual bookings materialize as WalkthroughSlot rows. The
// timezone is stored as an IANA name so DST does the right thing forever.
model AvailabilityRule {
  id          String   @id @default(cuid())
  weekday     Int // ISO: 1=Mon ... 7=Sun
  startMin    Int // minutes from local midnight
  endMin      Int
  slotMinutes Int      @default(20)
  timezone    String
  createdAt   DateTime @default(now())

  @@index([weekday])
}

// A signup that has passed validation but not yet paid. The school does NOT
// exist until Stripe confirms checkout — this row carries everything needed
// to build it the moment payment lands, from either the success redirect or
// the webhook, whichever arrives first (consumedAt makes fulfillment run
// exactly once). The password is hashed HERE, at intent time; the raw value
// never waits anywhere.
model SignupIntent {
  id              String    @id @default(cuid())
  schoolName      String
  slug            String
  state           String
  esaAmount       Float
  ownerName       String
  email           String
  passwordHash    String
  stripeSessionId String    @default("")
  consumedAt      DateTime?
  schoolId        String?
  createdAt       DateTime  @default(now())

  @@index([stripeSessionId])
}
